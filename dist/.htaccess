# Kilómetro Real · Apache / LiteSpeed (Namecheap)
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
# Forzar HTTPS y sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kilometroreal.com%{REQUEST_URI} [L,R=301]

# Secciones antiguas
RewriteRule ^novedades-precios/?$ /coches/ [L,R=301]

AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico

# Cabeceras de seguridad
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
<FilesMatch "\.(css|js|webp|jpg|png|svg|ico|woff2)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

# Archivos que no deben verse
<FilesMatch "^(\.htaccess|\.user\.ini|error_log|.*\.zip)$">
Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml image/x-icon text/plain application/xml text/xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 10 minutes"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType application/json "access plus 1 day"
ExpiresByType image/jpeg "access plus 6 months"
ExpiresByType image/webp "access plus 6 months"
ExpiresByType image/svg+xml "access plus 6 months"
ExpiresByType image/png "access plus 6 months"
ExpiresByType image/x-icon "access plus 6 months"
ExpiresByType application/xml "access plus 1 hour"
ExpiresByType text/xml "access plus 1 hour"
</IfModule>
